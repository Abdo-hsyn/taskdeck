# Server environment — copy to .env and fill in

# MySQL connection string (TiDB Cloud Serverless in production/dev)
# Get it from TiDB Cloud: Connect → Prisma / General
DATABASE_URL="mysql://user:password@host:4000/taskdeck?ssl-mode=REQUIRED"

# JWT signing secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"

# Comma-separated list of allowed client origins
CLIENT_ORIGINS="http://localhost:5173"

# Port the API listens on
PORT=4000

# Set to "production" in production (enables secure cookies)
NODE_ENV=development
